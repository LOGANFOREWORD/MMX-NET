--[[
  xrRazom — STALKER Anomaly Co-op
  Разом нас багато. (Together we are many.)

  Module: Stealth Overhaul (xcvb, GAMMA) — avatar visibility parity.

  Its visual_memory_manager.get_visible_value memory branch requires an
  IsStalker/IsMonster `who`, so NPC vision memory never accumulates against an
  avatar — peers were measurably harder to re-detect than the host in the same
  cover. The engine resolves the functor by name on every call
  (CVisualMemoryManager::get_visible_value), so a module-table wrap takes
  effect without re-registration.

  Gated on stealth_mcm: the base-game get_visible_value has no such gap, and
  this identifies the Stealth Overhaul variant regardless of which mod's file
  wins the MO2 merge.
]]

function on_game_start()
    if not stealth_mcm then return end
    local vmm = visual_memory_manager
    local orig = vmm and vmm.get_visible_value
    if type(orig) ~= "function" then return end

    vmm.get_visible_value = function(npc, who, ...)
        if who and XrrPlayers():IsPlayerDummy(who:id()) then
            local ok, result = XrrAvatarAwareCall(orig, npc, who, ...)
            if ok then return result end
            -- fall through on error: the engine needs a float back
        end
        return orig(npc, who, ...)
    end
    log("[xrRazom][stealth] avatar visibility parity installed")
end
