--[[
  xrRazom — the host→peer world m_data mirror.

  A peer never saves, so vanilla's load_state never populates its m_data and
  every mod that keeps a WORLD registry there reads an empty table — the player
  stash registry first among them, which is why crafting from a nearby stash
  contributes nothing on a peer. C++ re-encodes one manifest key at a time
  straight out of the host's live m_data and broadcasts it when the bytes
  change; the peer assigns it in. The host copy is authoritative: a peer-local
  write re-converges on the next rotation.

  The mirror image of xrr_peer_mdata.script, and it shares that file's codec —
  adding a mod is one manifest line here.
]]

-- WORLD-class m_data keys the host owns and peers only read. Default is
-- EXCLUSION: a key absent here keeps today's behaviour.
manifest = {
	-- Player-deployed stashes — id → item section. Read by GetStashesInRange
	-- (Craft From Stashes) and ~13 other GAMMA registry readers.
	"player_created_stashes",

	-- Hideout Furniture workbench → its hidden box. Four GAMMA mods walk the
	-- whole table, so a peer filling it one resolved workbench at a time read
	-- short. The HF patch touches this key on create — an open waits on it.
	"workshop_stashes",
}

-- Must match VALUE_DEPTH engine-side — both walks bottom out together or the
-- peer decodes a table the host truncated.
local MAX_DEPTH = 8

-- The manifest as a flat array — C++ reads it once when the rotation arms.
function xrr_world_mdata_manifest()
	return manifest
end

-- Host: one manifest key's current value. A direct m_data read, so nothing
-- fires the save_state registry at any cadence. Returns nil for an absent key,
-- which the mirror ships as a delete.
function xrr_world_mdata_live_key(key)
	local v = alife_storage_manager.get_state()[key]
	if v == nil then
		return nil
	end
	return xrr_mdata_encode(v, MAX_DEPTH)
end

-- Peer: replace the key wholesale. No SendScriptCallback fire and no per-entry
-- merge — the host is the only writer that counts, and a peer-local edit is
-- meant to be overwritten on the next rotation.
function xrr_world_mdata_apply(key, value)
	local m = alife_storage_manager.get_state()
	if value ~= nil then
		m[key] = xrr_mdata_decode(value, MAX_DEPTH)
	else
		m[key] = nil
	end
end

_G.xrr_world_mdata_manifest = xrr_world_mdata_manifest
_G.xrr_world_mdata_live_key = xrr_world_mdata_live_key
_G.xrr_world_mdata_apply    = xrr_world_mdata_apply
