--[[
  xrRazom — STALKER Anomaly Co-op
  Разом нас багато. (Together we are many.)

  Host-authoritative storyline rewards + quest-item attribution. Wraps xr_effects
  fired from restrictor condlists: suppress reward/economy effects on the peer,
  broadcast host rewards to all peers, and route quest-mechanic items to the single
  player who triggered the stage.
]]

-- xr_effects suppressed on the peer. remove_item / remove_quest_item are deliberately
-- absent so the crate-take's internal remove_item runs on the originator.
local SUPPRESS_ON_PEER = {
    -- money ----------------------------------------------------------------
    "reward_money", "reward_random_money", "reward_random_money_by_dist",
    "reward_item_cost_mult_and_remove", "drx_sl_money_task_payment",

    -- faction goodwill / rank ---------------------------------------------
    "inc_faction_goodwill_to_actor", "dec_faction_goodwill_to_actor",
    "complete_task_inc_goodwill", "fail_task_dec_goodwill",
    "inc_goodwill_by_tasker_comm", "inc_goodwill_by_tasker_id", "dec_goodwill_by_tasker_id",

    -- npc / squad relations (host-authoritative behaviour + RELATION_SYNC) --
    "actor_friend", "actor_neutral", "actor_enemy", "set_speaker_as_enemy",
    "set_squad_neutral_to_actor", "set_squad_friend_to_actor", "set_squad_enemy_to_actor",
    "set_squad_goodwill", "set_squad_goodwill_to_npc", "set_npc_sympathy",
    "set_squad_community_goodwill", "reset_faction_goodwill",

    -- task give / complete / fail / stage ----------------------------------
    "give_task", "set_task_completed", "set_task_failed",
    "inc_task_stage", "dec_task_stage", "set_task_stage",

    -- reward items (broadcast to ALL peers via REWARD_CAPTURE) -------------
    "reward_item", "reward_random_item", "reward_stash", "give_item", "give_items",
    "give_letter", "give_actor", "relocate_item", "give_treasure",
    "drx_sl_reward_random_rifle", "drx_sl_reward_random_artefact",

    -- relayed-call rewards (peer re-runs the vanilla effect; see relay_call) --
    "increase_rank", "decrease_rep", "devushka_quest_one_reward",
}

-- Quest-MECHANIC item give/take (delivery cases, key items, pendrives): fired only on
-- the client that originated the gating info, not broadcast like a reward.
local CRATE_FAMILY = {
    "lttz_ll_give_wpn_gauss_quest", "lttz_ll_give_gauss_ammo", "lttz_ll_give_strelok_pendrive",
    "lttz_ll_give_doctor_artefact", "lttz_oa_give_decryption_radio",
    "lttz_oa_give_special_delivery_case", "lttz_oa_give_army_isg_spy_pendrive",
    "lttz_ll_take_wpn_gauss_quest", "lttz_ll_take_strelok_notes", "lttz_ll_take_monolith_shard",
    "lttz_ll_take_strelok_pendrive", "lttz_ll_take_x8_documents", "lttz_ll_take_zat_b40_sarge_pda",
    "lttz_ms_take_stitch_decoder", "lttz_ms_take_attackers_pda", "lttz_ms_take_contact_lost_pda",
    "lttz_oa_take_decryption_radio", "lttz_oa_take_special_delivery_case",
    "lttz_oa_take_army_isg_spy_pendrive", "lttz_oa_take_jupiter_documents",
    "lttz_oa_take_drug_psy_blockade",
}

local function eco_rewards()  return game_difficulties.get_eco_factor("rewards")  or 1 end
local function eco_goodwill() return game_difficulties.get_eco_factor("goodwill") or 1 end

local function gw_from(delta, communities)
    local parts = {}
    for i = 1, #communities do
        parts[#parts + 1] = tostring(communities[i]) .. ":" .. tostring(delta)
    end
    return table.concat(parts, ",")
end

local function gw_by_tasker_id(p, sign)
    if not (p[1] and p[2]) then return 0, "", "" end
    local tm = task_manager.get_task_manager()
    local tinfo = tm and tm.task_info[p[1]]
    local giver_id = tinfo and tinfo.task_giver_id
    local npc = giver_id and db.storage[giver_id] and db.storage[giver_id].object
    if not npc then return 0, "", "" end
    local comm = character_community(npc)
    if comm == "trader" then comm = "stalker" end
    local amt = math.floor((tonumber(p[2]) or 50) * eco_goodwill() + 0.5)
    return 0, "", tostring(comm) .. ":" .. tostring(sign * amt)
end

-- Effects whose outcome can't be serialized: relay the CALL — the items blob carries
-- "@<effect>:<args>" and the peer's OnQuestReward re-runs the vanilla effect.
local function relay_call(name)
    return function(p)
        local parts = { "@" .. name }
        for i = 1, #p do parts[#parts + 1] = tostring(p[i]) end
        return 0, table.concat(parts, ":"), ""
    end
end

-- Per-effect host→peer reward capture → (money, items_blob, gw_blob) for SendQuestReward.
-- RANDOM money/item re-roll independently per player (intentional).
local REWARD_CAPTURE = {
    reward_money = function(p)
        return math.floor((tonumber(p[1]) or 500) * eco_rewards()), "", ""
    end,
    reward_random_money = function(p)
        local m = eco_rewards()
        local mn = math.floor(((tonumber(p[1]) or 500) * m) / 50)
        local mx = math.floor(((tonumber(p[2]) or (tonumber(p[1]) or 500) + 1000) * m) / 50)
        if mx < mn then mx = mn end
        return math.random(mn, mx) * 50, "", ""
    end,
    reward_random_money_by_dist = function(p)
        local var = utils_data.load_var(db.actor, p[1])
        local lvl_task = var and var.lvl_task or level.name()
        local lvl_target = var and var.lvl_target
        local n = lvl_task and lvl_target
            and txr_routes.get_shortest_path_num(lvl_task, lvl_target) or 1
        local m = eco_rewards()
        local mn = math.ceil(((tonumber(p[2]) or 500) * m) / 50)
        local mx = math.ceil(((tonumber(p[3]) or ((tonumber(p[2]) or 500) + 1000)) * m) / 50)
        if mx < mn then mx = mn end
        local money = math.random(mn, mx) * 50
        local sweets = math.ceil(n * money * (tonumber(p[4]) or 0.2))
        return money + sweets, "", ""
    end,
    reward_item        = function(p) return 0, tostring(p[1] or ""), "" end,
    reward_random_item = function(p)
        if #p == 0 then return 0, "", "" end
        return 0, tostring(p[math.random(#p)]), ""
    end,
    give_actor = function(p) return 0, table.concat(p, ","), "" end,
    give_item  = function(p) return 0, tostring(p[1] or ""), "" end,
    give_items = function(p) return 0, table.concat(p, ","), "" end,
    give_letter = function(p) return 0, tostring(p[1] or ""), "" end,
    complete_task_inc_goodwill = function(p)
        local delta = math.floor((tonumber(p[1]) or 50) * eco_goodwill())
        local comms = {}
        for i = 2, #p do comms[#comms + 1] = p[i] end
        return 0, "", gw_from(delta, comms)
    end,
    fail_task_dec_goodwill = function(p)
        local delta = -math.floor((tonumber(p[1]) or 50) * eco_goodwill())
        local comms = {}
        for i = 2, #p do comms[#comms + 1] = p[i] end
        return 0, "", gw_from(delta, comms)
    end,
    -- Deltas arrive eco-scaled and fractional; the peer-side gw parse is integer-only.
    inc_faction_goodwill_to_actor = function(p)
        if not (p[1] and p[2]) then return 0, "", "" end
        local amt = math.floor((tonumber(p[2]) or 0) + 0.5)
        return 0, "", tostring(p[1]) .. ":" .. tostring(amt)
    end,
    dec_faction_goodwill_to_actor = function(p)
        if not (p[1] and p[2]) then return 0, "", "" end
        local amt = math.floor((tonumber(p[2]) or 0) + 0.5)
        return 0, "", tostring(p[1]) .. ":" .. tostring(-amt)
    end,
    -- The by_tasker pair call inc_faction_goodwill_to_actor internally, and that nested
    -- call is capture-suppressed (xrr_in_reward_effect) — so mirror its resolution here.
    inc_goodwill_by_tasker_comm = function(p)
        if not (p[1] and p[2]) then return 0, "", "" end
        local var = utils_data.load_var(db.actor, p[1])
        local comm = var and var.task_giver_comm
        if not comm and db.actor:is_talking() then
            local speaker = mob_trade.GetTalkingNpc()
            comm = speaker and character_community(speaker)
        end
        if not comm then return 0, "", "" end
        if comm == "trader" then comm = "stalker" end
        local amt = math.floor((tonumber(p[2]) or 50) * eco_goodwill() + 0.5)
        return 0, "", tostring(comm) .. ":" .. tostring(amt)
    end,
    inc_goodwill_by_tasker_id = function(p)
        return gw_by_tasker_id(p, 1)
    end,
    dec_goodwill_by_tasker_id = function(p)
        return gw_by_tasker_id(p, -1)
    end,
    drx_sl_reward_random_rifle    = relay_call("drx_sl_reward_random_rifle"),
    drx_sl_reward_random_artefact = relay_call("drx_sl_reward_random_artefact"),
    increase_rank                 = relay_call("increase_rank"),
    decrease_rep                  = relay_call("decrease_rep"),
    devushka_quest_one_reward     = relay_call("devushka_quest_one_reward"),
}

_G.xrr_local_origin_info = _G.xrr_local_origin_info or {}
_G.xrr_remote_info       = _G.xrr_remote_info       or {}

local function on_actor_info(obj, info_id)
    if not info_id then return end
    local key = tostring(info_id)
    local net = XrrNet()
    if net and net:IsApplyingRemoteInfo() then
        _G.xrr_remote_info[key] = true              -- applied from the wire
        return
    end
    if _G.xrr_in_condlist_effects then return end   -- restrictor-set / re-derived
    _G.xrr_local_origin_info[key] = true            -- this client's dialog/action
end

-- Does a quest-mechanic give/take fire on THIS client? Reads the +info gates of the
-- condlist stashed by the pick_section wrap.
local function crate_should_fire()
    local cl = _G.xrr_current_condlist
    if not cl then return true end                  -- direct dialog action, not a condlist
    local local_o, remote_o = _G.xrr_local_origin_info, _G.xrr_remote_info
    local any_local, any_remote = false, false
    for i = 1, #cl do
        local checks = cl[i][2]
        if checks then
            for j = 1, #checks do
                local ip = checks[j]
                if ip[2] == 1 then
                    if local_o[ip[1]]  then any_local  = true end
                    if remote_o[ip[1]] then any_remote = true end
                end
            end
        end
    end
    if any_local then return true end
    if XrrIsHosted() and not any_remote then return true end
    return false
end

-- Host fetch-pay mute: vanilla fetch_reward_and_remove pays a second time through
-- reward_random_money after task_callback's full-value grant. Armed by the frar wrap,
-- consumed by the reward_random_money wrap; expires because frar can return early.
local _fetch_mute = { count = 0, expires = 0 }
local _frar_wrapped = false
local function arm_fetch_pay_mute()
    local now = time_global()
    if now > _fetch_mute.expires then _fetch_mute.count = 0 end
    _fetch_mute.count = _fetch_mute.count + 1
    _fetch_mute.expires = now + 3000
end
local function consume_fetch_pay_mute()
    if _fetch_mute.count > 0 and time_global() <= _fetch_mute.expires then
        _fetch_mute.count = _fetch_mute.count - 1
        return true
    end
    _fetch_mute.count = 0
    return false
end

-- Throttled logger for the pcall shields below: a throw inside a wrapped effect would
-- abort the whole condlist eval, divergently host vs peer — so fail open.
local _next_err_tg = 0
local function log_effect_err(name, err)
    local tg = time_global()
    if tg < _next_err_tg then return end
    _next_err_tg = tg + 5000
    printf("![xrRazom] patch_quest_story_effects: effect '%s' error (fail-open): %s",
        tostring(name), tostring(err))
end

function apply()
    if not _G.xrr_qse_info_hook then
        RegisterScriptCallback("actor_on_info_callback", on_actor_info)
        _G.xrr_qse_info_hook = true
    end

    -- (1) Mark condlist-effect context + stash the live condlist; crate effects resolve
    --     their gating info's originator from it.
    local _orig_pick = xr_logic.pick_section_from_condlist
    xr_logic.pick_section_from_condlist = function(obj, npc, condlist)
        if not (XrrIsClient() or XrrIsHosted()) then
            return _orig_pick(obj, npc, condlist)
        end
        local prev_in, prev_cl, prev_px, prev_sup =
            _G.xrr_in_condlist_effects, _G.xrr_current_condlist,
            _G.xrr_condlist_proximity, _G.xrr_suppress_condlist_info_sync
        _G.xrr_in_condlist_effects = true
        _G.xrr_current_condlist = condlist
        _G.xrr_condlist_proximity = false
        _G.xrr_suppress_condlist_info_sync = false
        local section = _orig_pick(obj, npc, condlist)
        _G.xrr_in_condlist_effects = prev_in
        _G.xrr_current_condlist = prev_cl
        _G.xrr_condlist_proximity = prev_px
        _G.xrr_suppress_condlist_info_sync = prev_sup
        return section
    end

    -- The peer's create_squad section still sets its self-latch +info; syncing that
    -- peer→host would close the host's `-info` gate before the host spawns. The flag is
    -- read C++-side in rpc_info_portion.
    local _of_create_squad = xr_effects.create_squad
    if _of_create_squad then
        xr_effects.create_squad = function(actor, npc, p)
            if XrrIsClient() and _G.xrr_in_condlist_effects then
                _G.xrr_suppress_condlist_info_sync = true
            end
            return _of_create_squad(actor, npc, p)
        end
    end

    -- (1b) Story PDA news: a fresh peer's restrictors replay their chain (join =
    --      new_game), so drop replayed beats unless a spatial trigger was reached.
    local STORY_NEWS = {
        "intercepted_transmission", "yanov_invitation", "yanov_invitation2",
        "gen_stitch_message",
        "pripyat_strelok_message", "pripyat_strelok_message2", "pripyat_rogue_message",
        "pripyat_stitch_message", "pripyat_degtyarev_message", "pripyat_unisg_message",
    }
    for _, ename in ipairs(STORY_NEWS) do
        local of_news = xr_effects[ename]
        if of_news then
            xr_effects[ename] = function(actor, npc, p)
                if XrrIsClient() and _G.xrr_in_condlist_effects
                   and not _G.xrr_condlist_proximity then
                    return  -- replayed past-beat notification on a fresh peer; drop
                end
                return of_news(actor, npc, p)
            end
        end
    end

    -- An actor-position gate passing inside a condlist eval is the only sign a give_task
    -- was physically reached rather than replayed. Flag set on the FINAL result so it
    -- composes with patch_actor_in_zone_team regardless of wrap order.
    for _, fname in ipairs({ "actor_near_smart", "actor_in_zone", "actor_inside_zone" }) do
        local of = xr_conditions[fname]
        if of then
            xr_conditions[fname] = function(actor, npc, p)
                local r = of(actor, npc, p)
                if r and _G.xrr_in_condlist_effects then _G.xrr_condlist_proximity = true end
                return r
            end
        end
    end

    -- (2) Reward/economy effects: suppress on peer; on host, pay locally then broadcast
    --     the capture subset to every peer.
    local wrapped, with_broadcast = 0, 0
    for _, name in ipairs(SUPPRESS_ON_PEER) do
        local orig = xr_effects[name]
        if orig then
            local capture = REWARD_CAPTURE[name]
            xr_effects[name] = function(actor, npc, p)
                if not (XrrIsClient() or XrrIsHosted()) then
                    return orig(actor, npc, p)  -- solo: vanilla verbatim (incl. throw semantics)
                end
                if XrrIsClient() and _G.xrr_in_condlist_effects then
                    -- Forward a proximity-reached give_task: the peer's restrictor fires
                    -- first and its +info closes the host's gate, so the host never
                    -- gives it. 65535 = no giver NPC. Info-gated gives are join-replay
                    -- and must NOT be forwarded.
                    if name == "give_task" and p and p[1] and _G.xrr_condlist_proximity then
                        printf("[xrRazom][quest] give_task(proximity) PEER -> forward SendQuestAccept task=%s",
                            tostring(p[1]))
                        XrrAlife():SendQuestAccept(p[1], 65535)
                    end
                    return
                end
                -- A condlist-fired reward (a real on_complete / restrictor one) never
                -- consumes the arm.
                if name == "reward_random_money" and not _G.xrr_in_condlist_effects
                   and consume_fetch_pay_mute() then
                    printf("[xrRazom][quest] fetch vanilla pay muted (task_callback grant is the payment)")
                    return
                end
                -- Nested-wrap guard: reward effects call other wrapped effects
                -- internally, and only the outermost may capture or the reward
                -- counts twice.
                local nested = _G.xrr_in_reward_effect
                _G.xrr_in_reward_effect = true
                local ok, err = pcall(orig, actor, npc, p)
                _G.xrr_in_reward_effect = nested
                if not ok then
                    log_effect_err(name, err)
                    return  -- effect didn't run on host: don't broadcast a reward
                end
                if capture and not nested and XrrIsHosted() and _G.xrr_in_condlist_effects then
                    local cok, money, items, gw = pcall(capture, p or {})
                    if not cok then
                        log_effect_err(name .. ":capture", money)
                    elseif _G.xrr_completing_task_id then
                        -- on_complete replay: accumulate; xrr_patch_quests sends ONE
                        -- combined QUEST_REWARD afterwards.
                        xrr_quest_reward.accum_add(money, items, gw)
                    elseif (money and money > 0) or (items and items ~= "")
                       or (gw and gw ~= "") then
                        XrrAlife():SendQuestReward("restrictor", money or 0,
                            items or "", gw or "")
                    end
                end
            end
            wrapped = wrapped + 1
            if capture then with_broadcast = with_broadcast + 1 end
        end
    end

    -- (2b) Arm the fetch-pay mute inside a hosted completion replay. Once-guarded: a
    --      re-apply() double-wrap would double-arm the mute count.
    if not _frar_wrapped then
        local _orig_frar = xr_effects.fetch_reward_and_remove
        if _orig_frar then
            _frar_wrapped = true
            xr_effects.fetch_reward_and_remove = function(actor, npc, p)
                if XrrIsHosted() and _G.xrr_completing_task_id then
                    arm_fetch_pay_mute()
                end
                return _orig_frar(actor, npc, p)
            end
        end
    end

    -- (3) Quest-mechanic give/take: in condlist context, fire only on the originating
    --     client; outside it, whoever is in the dialog.
    local crate_wrapped = 0
    for _, name in ipairs(CRATE_FAMILY) do
        local orig = xr_effects[name]
        if orig then
            xr_effects[name] = function(actor, npc, p)
                if not (XrrIsClient() or XrrIsHosted()) then
                    return orig(actor, npc, p)  -- solo: vanilla verbatim (incl. throw semantics)
                end
                if _G.xrr_in_condlist_effects and not crate_should_fire() then
                    return
                end
                local ok, err = pcall(orig, actor, npc, p)
                if not ok then log_effect_err(name, err) end
            end
            crate_wrapped = crate_wrapped + 1
        end
    end

    log("[xrRazom] patch_quest_story_effects: peer-suppress " .. tostring(wrapped)
        .. "/" .. tostring(#SUPPRESS_ON_PEER) .. ", host-broadcast " .. tostring(with_broadcast)
        .. ", crate-to-triggerer " .. tostring(crate_wrapped) .. "/" .. tostring(#CRATE_FAMILY))
end
