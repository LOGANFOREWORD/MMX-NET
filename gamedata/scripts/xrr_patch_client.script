    -- Wounded scheme never instantiates on a mirror, so vanilla is_wounded is
    -- always false; host wound state rides the NPC pstor snapshot instead.
    local function pstor_wounded_state(npc_id)
        local st = db.storage[npc_id]
        local s = st and st.pstor and st.pstor.wounded_state
        return s ~= nil and tostring(s) or "nil"
    end
    function xr_wounded.is_wounded(npc)
        return npc ~= nil and pstor_wounded_state(npc:id()) ~= "nil"
    end
    function xr_wounded.is_heavy_wounded_by_id(npc_id)
        return pstor_wounded_state(npc_id) ~= "nil"
    end
