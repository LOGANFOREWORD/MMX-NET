    -- Combat ignore: client never evaluates enemy status.
    xr_combat_ignore.is_enemy = RETURN_FALSE

    -- UICreateStash:OnAccept's alife_create("inv_backpack") returns nil under the
    -- block above; the marker comes back via MAP_SPOT_DELTA STASH_ADD.
    if item_backpack and item_backpack.UICreateStash then
        function item_backpack.UICreateStash:OnAccept()
            local actor = db.actor
            if not actor then return end
            local pos = actor:position()
            local txt = self.input and self.input:GetText() or ""
            local hint = (txt and txt ~= "") and txt
                or strformat(game.translate_string("st_itm_stash_of_character"),
                             actor:character_name())
            XrrWorld():SendPeerStashDeploy("inv_backpack",
                pos.x, pos.y, pos.z,
                actor:level_vertex_id(),
                actor:game_vertex_id(),
                hint, "treasure", self.section or "")
            actor_menu.set_msg(1, game.translate_string("st_stash_created"), 4)
            -- self.id was set in UICreateStash:Reset(obj) at dialog open.
            if self.id then alife_release_id(self.id) end
            self:Close()
        end
    end

    -- Quick Release (itm_actor_backpack): vanilla's own handler no-ops under the
    -- block above, and the item transfer must wait for the STASH_ADD anchor.
    local qr_keep_items = utils_data.collect_section(
        ini_file("items\\settings\\backpack_stash.ltx"),
        "actor_backpack_keep_items", true)
    local qr_seq = 0
    RegisterScriptCallback("actor_on_item_use", function(obj)
        if not (obj and obj:section() == "itm_actor_backpack") then return end
        local actor = db.actor
        if not actor then return end
        local backpack = actor:item_in_slot(13)
        if not backpack then return end  -- vanilla handler shows the message
        local b_id = backpack:id()

        local pos = vector():set(actor:position())
        -- Older stashes stacked on this spot must not swallow the transfer:
        -- remember them so the poll below only accepts the fresh anchor.
        local known = {}
        level.iterate_nearest(pos, 2, function(o)
            if o and o:section() == "inv_backpack" then known[o:id()] = true end
            return false
        end)

        XrrWorld():SendPeerStashDeploy("inv_backpack",
            pos.x, pos.y, pos.z,
            actor:level_vertex_id(), actor:game_vertex_id(),
            strformat(game.translate_string("st_itm_stash_of_character"),
                      actor:character_name()),
            "treasure", backpack:section())
        actor_menu.set_msg(1, game.translate_string("st_stash_created"), 4)
        alife_release_id(b_id)

        qr_seq = qr_seq + 1
        local my_seq = qr_seq
        local attempts = 0
        CreateTimeEvent("xrr_qr_backpack", my_seq, 0.25, function()
            local box
            level.iterate_nearest(pos, 2, function(o)
                if o and o:section() == "inv_backpack" and not known[o:id()] then
                    box = o
                    return true
                end
                return false
            end)
            if not box then
                attempts = attempts + 1
                if attempts > 60 then  -- ~15 s: give up, items stay with the actor
                    log("[xrRazom] quick-release: stash anchor never onlined, items kept")
                    return true
                end
                ResetTimeEvent("xrr_qr_backpack", my_seq, 0.25)
                return false
            end
            -- Vanilla item_backpack transfer filter, verbatim.
            db.actor:iterate_inventory(function(temp, item)
                if (item and item:id() ~= b_id and qr_keep_items[item:section()] == nil) then
                    if (IsAmmo(item) ~= true) or (item_backpack.is_ammo_for_wpn(item:section()) ~= true) then
                        if (ini_sys:r_bool_ex(item:section(), "quest_item", false) == false) then
                            if (db.actor:is_on_belt(item) == false and item_backpack.is_in_slot(item) == false) then
                                db.actor:transfer_item(item, box)
                            end
                        end
                    end
                end
            end)
            return true
        end)
    end)

    -- Psy phantoms: mirrors skip shedule_Update (CCustomMonster early-return),
    -- so monster_on_update never fires; use a periodic spatial query instead.
    local _phantom_sec_cache = {}
    xrr_register_cleanup(function() _phantom_sec_cache = {} end)  -- ids are per-session
    local function _phantom_section(npc)
        local id = npc:id()
        local v = _phantom_sec_cache[id]
        if v ~= nil then return v end
        local sec = npc:section()
        if ini_sys:r_bool_ex(sec, "can_spawn_phantom", false) then
            v = ini_sys:r_string_ex(sec, "spawn_phantom") or false
        else
            v = false
        end
        _phantom_sec_cache[id] = v
        return v
    end

    -- Throttle to vanilla's 5000 ms cadence: CreateTimeEvent re-fires every frame
    -- once elapsed, and the phantom count only updates async.
    local _phantom_next = 0
    CreateTimeEvent("xrr", "xrr_peer_phantoms", 5, function()
        if not db.actor then return false end
        local tg = time_global()
        if tg < _phantom_next then return false end
        _phantom_next = tg + 5000
        level.iterate_nearest(db.actor:position(), 30, function(obj)
            local cls = obj:clsid()
            if not (IsMonster(nil, cls) or IsStalker(nil, cls)) then return false end
            if not obj:alive() then return false end
            if not XrrMirrors():IsMirror(obj:id()) then return false end
            local sec = _phantom_section(obj)
            if sec and phantom_manager.dynamic_phantom_count(sec) <= 2 then
                local dir = vector_rotate_y(db.actor:direction(),
                    math.random() * 90 - 45)
                local r = 15 + math.random() * 15
                local pos = vector():set(obj:position())
                pos:add(dir:mul(r))
                phantom_manager.spawn_dynamic_phantom(sec, pos)
                return true
            end
            return false
        end)
        return false
    end)

    -- Player stashes (inv_backpack) must persist until empty, unlike real
    -- treasure spots.
    RegisterScriptCallback("actor_on_item_take_from_box", function(box, itm)
        if not box then return end
        if box:section() == "inv_backpack" and not box:is_inv_box_empty() then
            return
        end
        local id = box:id()
        local had_spot = false
        for _, spot in ipairs({"treasure", "treasure_searched", "treasure_unique"}) do
            if level.map_has_object_spot(id, spot) ~= 0 then
                level.map_remove_object_spot(id, spot)
                had_spot = true
            end
        end
        local had_flag = not had_spot
            and _G.xrr_treasure_boxes and _G.xrr_treasure_boxes[id]
        if had_flag then
            _G.xrr_treasure_boxes[id] = nil
            XrrWorld():SendPeerStashCleaned(id)
        end
    end)

    -- Vanilla would alife_release the host-owned box locally — a CSE freed under
    -- a live CObject. Empty-first: item transfers ride the container rails on
    -- their own clock, so a non-empty box could be released mid-transfer.
    RegisterScriptCallback("actor_on_stash_remove", function(data)
        if not data then return end
        data.cancel = true
        local id = data.stash_id
        local box = id and level.object_by_id(id)
        if not box then return end
        if not box:is_inv_box_empty() then
            actor_menu.set_msg(1, "Empty the stash before packing it up.", 4)
            return
        end
        xrr_use_intent.request{ verb = "xrr:stash_pickup", obj_id = id, state = true }
    end)

    if item_tent then
        function item_tent.itm_tent_func()
            local actor = db.actor
            if not actor then return end
            local sec = "itm_tent"
            local placeable = ini_sys:r_string_ex(sec, "placeable_section") or "ph_tent"
            local dir = actor:direction()
            local pos = actor:position():add(dir:mul(3))
            XrrWorld():SendPeerStashDeploy(placeable,
                pos.x, pos.y, pos.z,
                level.vertex_id(pos),
                actor:game_vertex_id(),
                ui_item.get_sec_name(sec),
                "ui_pda2_actor_sleep_location", "")
            alife_create_item("itm_tent_bag", actor)   -- pack-up bag, as vanilla
        end
    end

    -- use_place ("Place" action): vanilla's local alife_create returns nil here
    -- and CTDs. Forwarded with the __no_spot sentinel; facing angle is dropped.
    if itms_manager and itms_manager.use_place then
        function itms_manager.use_place(obj)
            local p = obj and obj:parent()
            if not (db.actor and p and p:id() == AC_ID) then return end
            local section = obj:section()
            alife_release_id(obj:id())
            local pos = db.actor:position()
            pos:add(device().cam_dir:mul(1.2))
            pos.y = db.actor:position().y + 1
            printf("[xrRazom] use_place peer-forward: %s", section)
            XrrWorld():SendPeerStashDeploy(section,
                pos.x, pos.y, pos.z,
                db.actor:level_vertex_id(),
                db.actor:game_vertex_id(),
                "", "__no_spot", "")
        end
    end

    -- Mutant-corpse loot: only the rolled table and the looted flag are
    -- host-owned. FDDA enhanced_animations wraps ui_mutant_loot.start at module
    -- load (so _mutant_orig_start is EA's wrap) and re-enters it with ea_flag.
    _mutant_orig_start = ui_mutant_loot.start
    ui_mutant_loot.start = function(obj, ...)
        if not obj then return _mutant_orig_start(obj, ...) end
        local id = obj:id()
        local ea = _G.enhanced_animations

        if ea and ea.ea_flag then
            -- EA anim-end re-entry: must reach the real start synchronously
            -- (EA indexes ui_mutant_loot.GUI right after this call).
            if _mutant_ea_local == id then
                _mutant_ea_local = nil
                return _mutant_orig_start(obj, ...)   -- crow/local: pure vanilla
            end
            -- This path bypasses the use-callback's looted gate, so re-assert it
            -- here; the cache must never fall through to a local roll.
            if se_load_var(id, obj:name(), "looted") then
                save_var(obj, "looted", true)
                return _mutant_orig_start(obj, ...)
            end
            if load_var(obj, "loot", nil) == nil then
                save_var(obj, "loot", {})
            end
            _mutant_remote_id = id
            return _mutant_orig_start(obj, ...)
        end

        if not XrrWorld():SendMutantLootRequest(id) then
            -- Remember the id so an EA anim-end re-entry stays vanilla too.
            if ea and ea.enable_animations and ea.mutant_loot_mod then
                _mutant_ea_local = id
            end
            return _mutant_orig_start(obj, ...)
        end
        -- Undo the local open-lock monster_on_actor_use_callback just set; the
        -- host verdict decides.
        se_save_var(id, obj:name(), "looted", false)
        -- EA re-enters start at anim end, so STATE must only cache the table.
        if ea and ea.enable_animations and ea.mutant_loot_mod then
            _mutant_ea_wait = id
        end
    end

    -- UI closed: write the remaining table back to the host and release its lock,
    -- for host-mediated sessions only — a crow's local UI must not send.
    local _orig_mutant_set_state = ui_mutant_loot.UIMutantLoot.SetMutantState
    ui_mutant_loot.UIMutantLoot.SetMutantState = function(self, is_more_loot, obj_mutant)
        _orig_mutant_set_state(self, is_more_loot, obj_mutant)
        local obj = obj_mutant or level.object_by_id(self.id)
        if not (obj and obj:id() == _mutant_remote_id) then return end
        _mutant_remote_id = nil
        local more = is_more_loot
        if more == nil then more = not is_empty(self.loot) end
        _mutant_close_tbl = self.loot or {}
        XrrWorld():SendMutantLootClose(obj:id(), more and true or false)
    end
end

-- Host replied to our MUTANT_LOOT REQUEST (routed via xrr_net_client).
function on_mutant_loot_state(local_id, verdict, tbl)
    local obj = level.object_by_id(local_id)
    local ea_wait = (_mutant_ea_wait == local_id)
    _mutant_ea_wait = nil
    if not obj then return end

    if verdict == 0 then
        -- FillList reads this cache instead of rolling; the looted mirror a
        -- previous denial may have set is cleared with it.
        save_var(obj, "loot", tbl or {})
        save_var(obj, "looted", nil)
        if ea_wait then
            -- EA's anim-end re-entry opens the UI from the cache; the local flag
            -- stays clear so an EA abort self-heals on the next use press.
            return
        end
        se_save_var(local_id, obj:name(), "looted", true)
        if _mutant_remote_id == local_id then return end   -- UI already up (EA fallback raced)
        _mutant_remote_id = local_id
        _mutant_orig_start(obj, local_id, obj:section(), obj:clsid())
        if not (ui_mutant_loot.GUI and ui_mutant_loot.GUI:IsShown()) then
            -- UI didn't open (another loot window up / empty-table edge):
            -- release the host lock right away so the corpse isn't wedged.
            _mutant_remote_id = nil
            local more = not is_empty(tbl or {})
            se_save_var(local_id, obj:name(), "looted", not more)
            _mutant_close_tbl = tbl or {}
            XrrWorld():SendMutantLootClose(local_id, more)
        end
    elseif verdict == 1 or verdict == 2 then
        -- Mirror the denial into both gates — the se flag (use-callback) and the
        -- pstor looted var (FillList, EA's direct start) — so no path rolls.
        save_var(obj, "loot", {})
        save_var(obj, "looted", true)
        se_save_var(local_id, obj:name(), "looted", true)
        if verdict == 1 then      -- nothing to loot (already looted / empty roll)
            actor_menu.set_msg(1, "st_body_useless", 3)
        else                      -- decayed
            actor_menu.set_msg(1, game.translate_string("st_body_decayed"), 4)
        end
    elseif verdict == 3 then      -- someone else has the UI open — retry later
        if ea_wait then
            -- Transient gate so the EA re-entry shows "useless" instead of
            -- rolling; cleared by the next granted STATE.
            save_var(obj, "looted", true)
        end
        actor_menu.set_msg(1, game.translate_string("st_xrr_mutant_body_busy"), 3)
    end
end

-- No Lua caller: the engine pulls (and clears) the staged remaining-loot table
-- when it writes CLOSE.
function xrr_get_mutant_close_table()
    local t = _mutant_close_tbl
    _mutant_close_tbl = nil
    return t
end
_G.xrr_get_mutant_close_table = xrr_get_mutant_close_table
