    unregister_cb("server_entity_on_unregister", warfare,               "squad_on_unregister")

    -- The host owns the smart-terrain simulation. The actor-local bookkeeping
    -- stays: vanilla and mods read dist_to_actor / nearest_to_actor_smart
    -- (dist-to-smart condlists, companion escort, campfire-save gates).
    function smart_terrain.se_smart_terrain:try_respawn() end
    function smart_terrain.se_smart_terrain:update()
        local se_actor = alife():actor()
        self.dist_to_actor = self.online and self.position:distance_to(se_actor.position) or math.huge

        if self.online then
            local nearest = smart_terrain.nearest_to_actor_smart
            if nearest.id then
                if nearest.id == self.id then
                    nearest.dist = self.dist_to_actor
                elseif self.dist_to_actor < nearest.dist then
                    nearest.id   = self.id
                    nearest.dist = self.dist_to_actor
                end
            else
                nearest.id   = self.id
                nearest.dist = self.dist_to_actor
            end
        end

        self.disabled = true
    end

