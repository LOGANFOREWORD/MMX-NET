--[[
  xrRazom — STALKER Anomaly Co-op
  Разом нас багато. (Together we are many.)

  Companion recruit / dismiss delegation (peer + host).

  axr_companions is host-authoritative, so on a peer the recruit/dismiss dialog
  actions forward to the host over the peer→host dialog-delegation channel
  (pseudo-id via XrrAlife():SendQuestAccept -> xrr_story_quest_handlers in
  xrr_patch_quests.script) instead of running locally. Recruited companions
  always join the HOST's squad — there is no per-peer squad.
]]

local NOP = function() end

function apply()
    _G.xrr_story_quest_handlers = _G.xrr_story_quest_handlers or {}

    if not dialogs_axr_companion then
        printe("[xrr_patch_companions] dialogs_axr_companion missing — companions not patched")
        return
    end

    -- Captured before the peer branch reassigns these fields, so the host
    -- handlers below always close over vanilla.
    local _orig_become = dialogs_axr_companion.become_actor_companion
    local _orig_remove = dialogs_axr_companion.remove_companions_from_squad

    -- HOST: consumed by OnQuestAccept; npc_host_id is the host-local id of the
    -- NPC the peer talked to.
    _G.xrr_story_quest_handlers["__companion_add"] = function(npc_host_id)
        local npc = npc_host_id and level.object_by_id(npc_host_id)
        if not npc then
            printf("[xrRazom][companion] __companion_add HOST: npc %s not online", tostring(npc_host_id))
            return
        end
        printf("[xrRazom][companion] __companion_add HOST -> become_actor_companion npc=%s", tostring(npc_host_id))
        _orig_become(db.actor, npc)
    end
    _G.xrr_story_quest_handlers["__companion_remove"] = function(npc_host_id)
        local npc = npc_host_id and level.object_by_id(npc_host_id)
        if not npc then
            printf("[xrRazom][companion] __companion_remove HOST: npc %s not online", tostring(npc_host_id))
            return
        end
        printf("[xrRazom][companion] __companion_remove HOST -> remove_companions_from_squad npc=%s", tostring(npc_host_id))
        _orig_remove(db.actor, npc)
    end

    -- PEER: forward the dialog actions to the host; nothing runs locally.
    if XrrIsHost() then return end

    local function forward(pseudo_id)
        local host_id = xrr_pending_npc_lock_host_id()
        if not (host_id and host_id > 0 and host_id < 65535) then
            printf("[xrRazom][companion] %s PEER: no lock host_id, dropping", pseudo_id)
            return
        end
        printf("[xrRazom][companion] %s PEER -> SendQuestAccept npc=%s", pseudo_id, tostring(host_id))
        XrrAlife():SendQuestAccept(pseudo_id, host_id)
    end

    dialogs_axr_companion.become_actor_companion       = function() forward("__companion_add") end
    dialogs_axr_companion.remove_companions_from_squad = function() forward("__companion_remove") end

    -- Squad-mutation entry points + content-mod dialog aliases route through the
    -- same forwarders; companion_squads is empty on the peer already.
    axr_companions.add_to_actor_squad      = dialogs_axr_companion.become_actor_companion
    axr_companions.remove_from_actor_squad = dialogs_axr_companion.remove_companions_from_squad
    axr_companions.companion_add_waypoints    = NOP
    axr_companions.companion_remove_waypoints = NOP

    if dialogs_lostzone then
        dialogs_lostzone.set_stalker_living_legend_as_companion     = dialogs_axr_companion.become_actor_companion
        dialogs_lostzone.dismiss_speaker_companion                  = dialogs_axr_companion.remove_companions_from_squad
        dialogs_lostzone.set_degtyarev_taskforce_squad_as_companion = dialogs_axr_companion.become_actor_companion
    end
    if dialogs_agr_u then
        dialogs_agr_u.set_speaker_as_companion = dialogs_axr_companion.become_actor_companion
    end
end
