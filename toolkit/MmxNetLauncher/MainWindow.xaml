<Window x:Class="MmxNetLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MMX-Net 0.1.0 — xrRazom"
        Height="700" Width="1020"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0A0A"
        WindowStyle="None"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Border Background="#FF080808"/>
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="36" Background="#FF121212" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="12,0,8,0">
          <TextBlock x:Name="TitleLabel" VerticalAlignment="Center" Foreground="#FFE8C84A" FontSize="12" FontWeight="SemiBold"
                     Text="MMX-Net — xrRazom" IsHitTestVisible="False"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="SteamBadge" Foreground="{StaticResource Ok}" FontSize="11" Margin="0,0,12,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="UpdateBtn" Content="⬇" Width="40" Height="28" Click="Update_Click"
                    Background="Transparent" Foreground="{StaticResource Accent}" BorderThickness="0" FontSize="14"
                    ToolTip="Controlla aggiornamenti MMX-Net"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="—" Width="40" Height="28" Click="TitleMin_Click" Background="Transparent"
                    Foreground="#FFBDBDBD" BorderThickness="0" FontSize="14"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="×" Width="40" Height="28" Click="TitleClose_Click" Background="Transparent"
                    Foreground="#FFBDBDBD" BorderThickness="0" FontSize="16"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Height="88" Background="#99000000">
        <Grid Margin="20,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            <CheckBox x:Name="UseSteamBox" Content="Steam = Call of Pripyat (41700) — inviti Shift+Tab" IsChecked="True"
                      Foreground="{StaticResource Text}" Margin="0,8,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="AGGIORNA" Style="{StaticResource OutlineBtn}" Margin="8,0"
                  Padding="14,12" Click="Update_Click" VerticalAlignment="Center"
                  ToolTip="Scarica overlay MMX-Net se c'è una versione nuova"/>
          <Button Grid.Column="2" Content="HEALTH" Style="{StaticResource OutlineBtn}" Margin="8,0"
                  Padding="16,12" Click="Health_Click" VerticalAlignment="Center"/>
          <Button Grid.Column="3" Content="HOST" Style="{StaticResource OutlineBtn}" Margin="8,0"
                  Padding="20,12" Click="Host_Click" VerticalAlignment="Center"
                  ToolTip="Host Steam: avvia partita, poi invita da Shift+Tab. Niente dialog IP."/>
          <Button Grid.Column="4" Content="PLAY" Style="{StaticResource OutlineAccentBtn}" Margin="8,0,0,0"
                  Padding="28,12" Click="Play_Click" VerticalAlignment="Center"
                  ToolTip="Join: Steam → Join Game sull'host. Non usare Connect IP nel menu."/>
        </Grid>
      </Border>

      <Grid Margin="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Panel}" Padding="18" BorderBrush="{StaticResource LineDim}" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="PACK / NET" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock x:Name="PackInfo" DockPanel.Dock="Top" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                         Text="Overlay/inviti: Steam deve avviare Anomaly (non il launcher in diretto). HOST registra il gioco in libreria e lo lancia da Steam. Poi in partita Shift+Tab → Invite. Su Steam: Impostazioni → In gioco → Overlay attivo. Connect IP = solo LAN."/>

              <!-- Visibile solo nel build DEVKIT (MMX-Net-Launcher-dev.exe) -->
              <Border x:Name="DevPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,4,0,16"
                      Background="#181818" BorderBrush="{StaticResource LineDim}" BorderThickness="1" Padding="12">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="DEVKIT — CARICA AGGIORNAMENTO" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="DevRefreshBtn" DockPanel.Dock="Right" Content="REFRESH" Style="{StaticResource OutlineBtn}"
                            Padding="10,4" Margin="8,0,0,0" Click="DevRefresh_Click"
                            ToolTip="Rileva di nuovo modifiche pack/overlay vs ultimo publish"
                            HorizontalAlignment="Right"/>
                  </DockPanel>
                  <Border x:Name="DevChangesBadge" Background="#332A1A00" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                          Padding="8,6" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="DevChangesText" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" Text="Ci sono modifiche non pubblicate"/>
                  </Border>
                  <TextBlock x:Name="DevChangesList" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                             Margin="0,0,0,10" Visibility="Collapsed"/>
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                             Text="One-click: prepara zip+manifest in dist\update\, copia su sync se configurato. Gli amici col feed vedono il popup all'avvio."/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Versione" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="DevVersionBox" Grid.Column="1" Height="28" Margin="6,0,8,0" Padding="6,4"
                             Background="{StaticResource InputBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="Channel" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="DevChannelBox" Grid.Column="3" Height="28" Margin="6,0,0,0" Padding="6,4"
                             Background="{StaticResource InputBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="12"/>
                  </Grid>
                  <CheckBox x:Name="DevAutoBumpBox" Content="Auto-bump patch se ci sono modifiche (es. 0.1.1 → 0.1.2)"
                            Foreground="{StaticResource Text}" FontSize="11" Margin="0,0,0,8" IsChecked="True"/>
                  <TextBlock Text="Note (changelog)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                  <TextBox x:Name="DevNotesBox" Height="52" Margin="0,0,0,8" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True"
                           Background="{StaticResource InputBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="12"/>
                  <TextBlock Text="URL feed (updateFeedUrl; repo privata ⇒ amici usano updateFeedToken)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                  <TextBox x:Name="DevFeedUrlBox" Height="28" Margin="0,0,0,8" Padding="6,4"
                           Background="{StaticResource InputBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="12"
                           ToolTip="Es. https://raw.githubusercontent.com/USER/mmx-net-updates/main/ — amici: PAT in updateFeedToken"/>
                  <TextBlock Text="Cartella sync / clone feed (PublishTarget)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                  <TextBox x:Name="DevSyncBox" Height="28" Margin="0,0,0,10" Padding="6,4"
                           Background="{StaticResource InputBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="12"
                           ToolTip="Clone locale della repo feed (es. dist\update-feed); dopo CARICA: push_update_feed.ps1"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="DevPublishBtn" Content="CARICA AGGIORNAMENTO" Style="{StaticResource OutlineAccentBtn}"
                            Padding="12,8" Margin="0,0,8,0" Click="DevPublish_Click"
                            ToolTip="One-click: bump opzionale → zip+manifest → sync → feed amici"/>
                    <Button x:Name="DevOpenFolderBtn" Content="APRI CARTELLA" Style="{StaticResource OutlineBtn}"
                            Padding="12,8" Margin="0,0,8,0" Click="DevOpenFolder_Click"/>
                    <Button x:Name="DevCopyUrlBtn" Content="COPIA URL" Style="{StaticResource OutlineBtn}"
                            Padding="12,8" Click="DevCopyUrl_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="DevPublishStatus" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock DockPanel.Dock="Top" Text="HEALTH CHECK" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,8,0,8"/>
              <TextBlock x:Name="HealthSummary" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
              <ItemsControl x:Name="HealthList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <TextBlock Width="56" FontSize="11" FontWeight="SemiBold"
                                 Text="{Binding Sev}" Foreground="{Binding SevBrush}"/>
                      <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Msg}"
                                 Foreground="{Binding MsgBrush}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="18" BorderBrush="{StaticResource LineDim}" BorderThickness="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="LOG" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Background="{StaticResource InputBg}"
                     Foreground="{StaticResource Text}" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
