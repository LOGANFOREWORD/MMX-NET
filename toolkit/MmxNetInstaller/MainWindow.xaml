<Window x:Class="MmxNetInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMX-Net — Installer"
        Height="560" Width="720"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0A0A"
        ResizeMode="CanMinimize">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BrowseBtn" Content="SFOGLIA…" Style="{StaticResource OutlineBtn}" Margin="0,0,8,0" Click="Browse_Click"/>
      <Button x:Name="InstallBtn" Content="INSTALLA OVERLAY" Style="{StaticResource OutlineAccentBtn}" Click="Install_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="MMX-Net" Foreground="{StaticResource Accent}" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Installer overlay + launcher" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,4,0,20"/>

        <TextBlock Text="Dove installare" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,0,12"
                   Text="Installa nella cartella «Anomaly Coop» (base Anomaly già presente lì). Non mescolare file con Anomaly vanilla: serve una copia dedicata così fingerprint e pack restano allineati tra amici."/>

        <TextBlock Text="Percorso installazione" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="PathBox" Height="32" Padding="8,6" Background="{StaticResource InputBg}"
                 Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="13"/>

        <CheckBox x:Name="CopyFromBox" Margin="0,16,0,6" Foreground="{StaticResource Text}"
                  Content="Copia prima da un'install Anomaly coop esistente (opzionale)"/>
        <TextBox x:Name="SourceBox" Height="32" Padding="8,6" Background="{StaticResource InputBg}"
                 Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="13"
                 IsEnabled="{Binding IsChecked, ElementName=CopyFromBox}"/>
        <Button Content="Scegli sorgente…" Style="{StaticResource OutlineBtn}" Margin="0,8,0,0"
                HorizontalAlignment="Left" Click="BrowseSource_Click"
                IsEnabled="{Binding IsChecked, ElementName=CopyFromBox}"/>

        <TextBlock Text="Requisiti" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,24,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18"
                   Text="• Anomaly 1.5.3 coop già nella cartella «Anomaly Coop» (o copia dalla sorgente).&#10;• Steam installato; Call of Pripyat (41700) in libreria per overlay/inviti Shift+Tab.&#10;• Questo installer NON redistribuisce db/bin Anomaly interi: applica solo overlay Coop + launcher.&#10;• Dopo l'install: avvia MMX-Net-Launcher.exe dalla cartella Anomaly Coop."/>

        <TextBlock x:Name="StatusText" Margin="0,20,0,0" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
