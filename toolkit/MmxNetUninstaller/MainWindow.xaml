<Window x:Class="MmxNetUninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMX-Net — Disinstalla"
        Height="420" Width="640"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0A0A"
        ResizeMode="CanMinimize">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BrowseBtn" Content="SFOGLIA…" Style="{StaticResource OutlineBtn}" Margin="0,0,8,0" Click="Browse_Click"/>
      <Button x:Name="UninstallBtn" Content="DISINSTALLA MMX-NET" Style="{StaticResource OutlineAccentBtn}" Click="Uninstall_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="MMX-Net" Foreground="{StaticResource Accent}" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Disinstalla overlay (non tocca Anomaly base)" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,4,0,20"/>

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,0,16"
                   Text="Rimuove launcher MMX-Net, bridge Steam, ac_config/version, script xrr_* e overlay pack. Non cancella AnomalyLauncher, db/ né i bin engine vanilla."/>

        <TextBlock Text="Cartella «Anomaly Coop»" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="PathBox" Height="32" Padding="8,6" Background="{StaticResource InputBg}"
                 Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" FontSize="13"/>

        <TextBlock x:Name="StatusText" Margin="0,20,0,0" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
